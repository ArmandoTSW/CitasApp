<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CitasApp.Application\CitasApp.Application.csproj" />
    <ProjectReference Include="..\PetConnect.Domain\CitasApp.Domain.csproj" />
    <ProjectReference Include="..\PetConnect.Infrastructure\CitasApp.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Data\" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Data\citas.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="Data\medicos.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="Data\pacientes.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

	<ItemGroup>
		<Compile Remove="CitasApp.Api\**\*.cs" />
		<Compile Remove="CitasApp.Application\**\*.cs" />
		<Compile Remove="CitasApp.Domain\**\*.cs" />
		<Compile Remove="CitasApp.Infrastructure\**\*.cs" />

		<Content Remove="CitasApp.Api\**" />
		<Content Remove="CitasApp.Application\**" />
		<Content Remove="CitasApp.Domain\**" />
		<Content Remove="CitasApp.Infrastructure\**" />

		<None Remove="CitasApp.Api\**" />
		<None Remove="CitasApp.Application\**" />
		<None Remove="CitasApp.Domain\**" />
		<None Remove="CitasApp.Infrastructure\**" />
	</ItemGroup>

</Project>
